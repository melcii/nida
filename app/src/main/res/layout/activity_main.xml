<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/menu"
                    style="@style/Nida.Icon"
                    android:layout_marginStart="-12dp"
                    android:contentDescription="@string/menu"
                    android:src="@drawable/ic_menu" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/openSettings"
                    style="@style/Nida.Icon"
                    android:layout_marginEnd="-12dp"
                    android:contentDescription="@string/settings"
                    android:src="@drawable/ic_tune" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/placeLabel"
                    style="@style/Nida.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical" />

                <TextView
                    android:id="@+id/placeName"
                    style="@style/Nida.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:maxLines="1"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/hijri"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/accent"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/gregorian"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/segment_bg"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/tabSimple"
                    style="@style/Nida.Tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tab_simple" />

                <TextView
                    android:id="@+id/tabDetailed"
                    style="@style/Nida.Tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tab_detailed" />

                <TextView
                    android:id="@+id/tabQibla"
                    style="@style/Nida.Tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tab_qibla" />

                <TextView
                    android:id="@+id/tabCalendar"
                    style="@style/Nida.Tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tab_calendar" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/stage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:clipChildren="false">

                <!-- Simple: what's next and how long until it -->
                <LinearLayout
                    android:id="@+id/viewSimple"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="36dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="32dp">

                    <TextView
                        android:id="@+id/nextLabel"
                        style="@style/Nida.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/nextLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/inter_light"
                        android:letterSpacing="-0.02"
                        android:textColor="@color/ink"
                        android:textSize="56sp" />

                    <TextView
                        android:id="@+id/nextAt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/muted"
                        android:textSize="15sp" />

                    <app.nida.NightBar
                        android:id="@+id/simpleBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp" />

                    <TextView
                        android:id="@+id/since"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Detailed: every time, the forbidden times, and the night -->
                <LinearLayout
                    android:id="@+id/viewDetailed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/Nida.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp"
                        android:text="@string/prayer_times" />

                    <LinearLayout
                        android:id="@+id/timesGroup"
                        style="@style/Nida.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp" />

                    <TextView
                        style="@style/Nida.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:paddingStart="4dp"
                        android:text="@string/night" />

                    <LinearLayout
                        style="@style/Nida.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:paddingTop="18dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:id="@+id/nightTitle"
                            style="@style/Nida.RowText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            android:fontFamily="@font/inter_medium" />

                        <TextView
                            android:id="@+id/nightSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="20dp"
                            android:textColor="@color/muted"
                            android:textSize="13sp" />

                        <app.nida.NightBar
                            android:id="@+id/nightBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="14dp"
                            android:layout_marginEnd="12dp"
                            android:layout_marginBottom="6dp" />

                        <LinearLayout
                            android:id="@+id/nightGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <TextView
                        style="@style/Nida.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:paddingStart="4dp"
                        android:text="@string/forbidden" />

                    <LinearLayout
                        android:id="@+id/forbiddenGroup"
                        style="@style/Nida.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingMultiplier="1.3"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/forbidden_note"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Qibla -->
                <LinearLayout
                    android:id="@+id/viewQibla"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="28dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/qiblaFor"
                        style="@style/Nida.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp" />

                    <app.nida.QiblaDial
                        android:id="@+id/dial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/qiblaDeg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/inter_light"
                        android:textColor="@color/ink"
                        android:textSize="40sp" />

                    <TextView
                        android:id="@+id/qiblaSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/muted"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/qiblaHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />

                    <!-- Compass calibration: a figure-8, shown when the compass is unsure or on request -->
                    <LinearLayout
                        android:id="@+id/calibCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/note_bg"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:visibility="gone">

                        <app.nida.Figure8
                            android:layout_width="150dp"
                            android:layout_height="70dp" />

                        <TextView
                            android:id="@+id/calibTitle"
                            style="@style/Nida.RowText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/inter_medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.3"
                            android:text="@string/calib_body"
                            android:textColor="@color/muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Where the location came from, and what to do if it's weak or off -->
                    <LinearLayout
                        android:id="@+id/locStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/locText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.3"
                            android:textColor="@color/muted"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/locAction"
                            style="@style/Nida.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/calibLink"
                        style="@style/Nida.Link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/calib_link"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Calendar: any day's times -->
                <LinearLayout
                    android:id="@+id/viewCalendar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_bg"
                        android:orientation="vertical"
                        android:paddingStart="10dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/prevMonth"
                                style="@style/Nida.Icon"
                                android:contentDescription="@string/prev_month"
                                android:src="@drawable/ic_back" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/monthTitle"
                                    style="@style/Nida.RowText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/inter_medium"
                                    android:textSize="16sp" />

                                <TextView
                                    android:id="@+id/monthHijri"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="@color/accent"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/nextMonth"
                                style="@style/Nida.Icon"
                                android:contentDescription="@string/next_month"
                                android:src="@drawable/ic_next" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/monthGrid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/dayTitle"
                        style="@style/Nida.RowText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:fontFamily="@font/inter_medium"
                        android:paddingStart="4dp" />

                    <TextView
                        android:id="@+id/dayHijri"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:paddingStart="4dp"
                        android:textColor="@color/accent"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/dayGroup"
                        style="@style/Nida.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp" />
                </LinearLayout>

                <!-- No location yet -->
                <LinearLayout
                    android:id="@+id/viewEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_bg"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="28dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_pin" />

                    <TextView
                        android:id="@+id/emptyTitle"
                        style="@style/Nida.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/location_title"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/emptyBody"
                        style="@style/Nida.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/location_body"
                        android:textColor="@color/muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/allow"
                        style="@style/Nida.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/allow_location" />

                    <TextView
                        android:id="@+id/chooseCity"
                        style="@style/Nida.Link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/choose_city" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#59000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:background="@color/paper"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <TextView
            style="@style/Nida.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:gravity="start"
            android:text="@string/places"
            android:textSize="26sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/placeList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/addCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/pill_bg"
            android:gravity="center"
            android:minHeight="52dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_plus" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/inter_medium"
                android:text="@string/add_city"
                android:textColor="@color/accent"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
